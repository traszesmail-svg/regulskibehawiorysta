# Runtime modes
APP_DATA_MODE=supabase
# default live mode uses manual payment; stripe/mock remain only for legacy QA paths
APP_PAYMENT_MODE=manual

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set this to your production HTTPS domain after adding the custom .pl domain in Vercel.
# Optional, consent-gated GA4 measurement ID. Internal KPI uses first-party funnel ledger instead.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional Cookiebot CMP domain group ID used for external consent management.
NEXT_PUBLIC_COOKIEBOT_DOMAIN_GROUP_ID=
JITSI_BASE_URL=https://meet.jit.si
RESERVATION_WINDOW_MINUTES=15
ADMIN_ACCESS_SECRET=
TEST_CHECKOUT_ENABLED=false
QA_CHECKOUT_EMAIL_ALLOWLIST=
QA_CHECKOUT_PHONE_ALLOWLIST=
# Optional browser override for local Playwright smoke tests and crawlers.
# Leave empty to auto-detect Playwright's bundled headless shell, Chrome, or Edge.
BROWSER_EXECUTABLE_PATH=

# Mail / reminders
MAIL_PROVIDER=resend
RESEND_API_KEY=
# Use the verified Regulski sender.
RESEND_FROM_EMAIL=Regulski Behawiorysta <kontakt@regulskibehawiorysta.pl>
# Live readiness expects `CUSTOMER_EMAIL_MODE=auto`; use `disabled` only as a temporary diagnostic override.
CUSTOMER_EMAIL_MODE=auto
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
GMAIL_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=krzyre@gmail.com
REGULSKI_CONTACT_EMAIL=kontakt@regulskibehawiorysta.pl
# Shared secret for the protected reminder runner endpoint triggered by Supabase scheduler
CRON_SECRET=
# Web push reminders for installed PWA/browser notifications.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kontakt@regulskibehawiorysta.pl

# Manual payment
MANUAL_PAYMENT_PAYPAL_ME_URL=
MANUAL_PAYMENT_ACCOUNT_NAME=
MANUAL_PAYMENT_INSTRUCTIONS=
MANUAL_PAYMENT_HOLD_MINUTES=60
MANUAL_PAYMENT_REVIEW_SECRET=

# Naffy online payment
NAFFY_ACCOUNT_EMAIL=krzyre@gmail.com
NAFFY_PAYMENT_URL=
# Backward-compatible alias for old local env names.
NAFFY_CHECKOUT_URL=
# Optional per-consultation Naffy checkout links. These take precedence over the global URL for consultation orders.
NAFFY_CONSULTATION_QUICK_URL=
NAFFY_CONSULTATION_URGENT_URL=
NAFFY_CONSULTATION_30_URL=
NAFFY_CONSULTATION_FULL_URL=

# Legacy/internal SMS fallback. New customer booking and material forms do not collect phone numbers.
SMS_PROVIDER=disabled
SMS_API_KEY=
SMS_SENDER=
SMS_API_BASE_URL=https://api.smsapi.com

# Legacy/internal SMS webhook fallback
SMS_NOTIFICATION_WEBHOOK_URL=
SMS_NOTIFICATION_WEBHOOK_TOKEN=

# Supabase live mode
NEXT_PUBLIC_SUPABASE_URL=
# Must be a real service-role key (sb_secret_... or legacy JWT with role=service_role), never sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=

# PayU
# Keep disabled until the production rollout smoke passes.
PAYU_MODE=disabled
PAYU_ENVIRONMENT=sandbox
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=
PAYU_POS_ID=
PAYU_SECOND_KEY=
# Optional public URL used by npm run payu-smoke:production or a controlled Vercel deployment smoke.
PAYU_SMOKE_URL=

# Legacy Stripe mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
